    <string name="small_bodies_add_asteroid_title">Add asteroid</string>
    <string name="small_bodies_add_asteroid_message">Enter an asteroid number or name to fetch orbital elements from JPL SBDB. Examples: 1, Ceres, 4 Vesta, Pallas. Ambiguous names automatically prefer asteroid candidates.</string>
