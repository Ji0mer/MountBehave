    <string name="small_bodies_add_comet_title">Add comet</string>
    <string name="small_bodies_add_comet_message">Enter a comet designation or name to fetch orbital elements from JPL SBDB. Examples: 1P, 2P, 67P, C/2023 A3, Halley, Encke. Elliptic, parabolic, and hyperbolic orbits are supported except very deep hyperbolic interstellar visitors.</string>
